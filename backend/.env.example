# PayPilot Backend Environment Configuration Template
PROJECT_NAME=PayPilot
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
# Local SQLite Async (zero setup): sqlite+aiosqlite:///./paypilot.db
# Production PostgreSQL Async: postgresql+asyncpg://user:password@localhost:5432/paypilot
DATABASE_URL=sqlite+aiosqlite:///./paypilot.db

# Razorpay Credentials (Test Mode)
# Obtain your test keys from: https://dashboard.razorpay.com/#/access/api-keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=paypilot_webhook_secret_dev

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
