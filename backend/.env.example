PROJECT_NAME=PayPilot
ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration (Default: SQLite async for local zero-config, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./paypilot.db

# Razorpay Credentials (Test mode by default)
# Sign up at https://dashboard.razorpay.com/#/access/api-keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=paypilot_webhook_secret_dev

# AI LLM Keys (Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini # 'gemini' or 'openai' or 'mock'
